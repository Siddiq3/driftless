{
  "name": "driftless",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --ci",
    "doctor": "expo-doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@siddiq3/driftless-contracts": "0.3.0",
    "expo": "~57.0.30",
    "expo-auth-session": "~57.0.0",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.0",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.0",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.0",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.0",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^22.15.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "3.8.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|zod|@siddiq3/.*)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^tracking-android$": "<rootDir>/modules/tracking-android/src",
      "^billing-android$": "<rootDir>/modules/billing-android/src"
    }
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
