<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- Usage Access (special app access granted by the user in Settings): minutes in supported apps. -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

  <!-- Needed on Android 11+ to read the installed version of the supported apps (rule gating). -->
  <queries>
    <package android:name="com.instagram.android" />
    <package android:name="com.google.android.youtube" />
    <package android:name="com.facebook.katana" />
    <package android:name="com.snapchat.android" />
    <package android:name="in.mohalla.video" />
    <package android:name="in.mohalla.sharechat" />
  </queries>

  <application>
    <receiver android:name="app.driftless.tracking.android.CountWidget" android:exported="false" android:label="Driftless daily count">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="android.intent.action.DATE_CHANGED"/><action android:name="android.intent.action.TIMEZONE_CHANGED"/><action android:name="android.intent.action.TIME_SET"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/driftless_count_widget_info"/>
    </receiver>
    <!-- Driftless's own dismissible pause screen (no SYSTEM_ALERT_WINDOW, no overlay). -->
    <activity
      android:name="app.driftless.tracking.android.PauseActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleTask"
      android:taskAffinity="app.driftless.pause"
      android:noHistory="true" />
    <activity
      android:name="app.driftless.tracking.android.AccessibilityGuideActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:taskAffinity="app.driftless.accessibilityguide"
      android:supportsPictureInPicture="true"
      android:resizeableActivity="true"
      android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
      android:theme="@android:style/Theme.Material.NoActionBar" />
    <service
      android:name="app.driftless.tracking.android.DriftlessAccessibilityService"
      android:exported="false"
      android:label="@string/driftless_a11y_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/driftless_accessibility" />
    </service>
  </application>
</manifest>
