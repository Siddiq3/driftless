<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/count_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/count_widget_bg" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp">
  <ImageView android:id="@+id/count_widget_mascot" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_mascot_fresh" android:scaleType="fitCenter" android:contentDescription="ScrollSnooze companion"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/count_widget_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false"/>
    <TextView android:id="@+id/count_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open ScrollSnooze" android:textColor="#FFE1A4" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
</LinearLayout>
