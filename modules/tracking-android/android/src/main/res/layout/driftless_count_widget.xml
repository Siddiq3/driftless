<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/count_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/count_widget_bg" android:padding="18dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/count_widget_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="60dp" android:text="—" android:textColor="#FFFFFF" android:textSize="46sp" android:textStyle="bold" android:maxLines="1"/>
    <TextView android:id="@+id/count_widget_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Short videos today" android:textColor="#FFFFFF" android:textSize="14sp"/>
    <TextView android:id="@+id/count_widget_goal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFE1A4" android:textSize="13sp" android:textStyle="bold" android:visibility="gone"/>
    <TextView android:id="@+id/count_widget_streak" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#E6D8FF" android:textSize="13sp" android:visibility="gone"/>
    <TextView android:id="@+id/count_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open ScrollSnooze" android:textColor="#D9CCF2" android:textSize="11sp" android:layout_marginTop="8dp"/>
  </LinearLayout>
  <ImageView android:id="@+id/count_widget_mascot" android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="top|end" android:src="@drawable/widget_mascot_fresh" android:scaleType="fitCenter" android:contentDescription="ScrollSnooze companion"/>
</FrameLayout>
