{
  "name": "@driftless/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --ci",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@driftless/contracts": "workspace:*",
    "@driftless/design-tokens": "workspace:*",
    "@driftless/domain": "workspace:*",
    "expo": "~58.0.10",
    "expo-auth-session": "~58.0.12",
    "expo-build-properties": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.6",
    "expo-dev-client": "~58.0.13",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-router": "~58.0.19",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-web-browser": "~58.0.6",
    "react": "19.2.9",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.10",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|zod|@driftless/.*)"
    ]
  }
}
