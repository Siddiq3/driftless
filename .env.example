# Public build configuration. Both clients must use the same Google Web OAuth client ID.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WEBSITE_URL=https://scrollsnooze.vercel.app
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional: iOS OAuth client for this bundle ID; required for Google login on iPhone.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional verified HTTPS invite origin. Defaults to the API origin for web landing pages.
EXPO_PUBLIC_JOIN_BASE_URL=https://scrollsnooze.vercel.app
